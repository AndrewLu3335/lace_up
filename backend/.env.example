# Copy to .env and fill in values. Never commit .env.

DEBUG=True
SECRET_KEY=change-me-generate-a-long-random-string

DB_NAME=lace_up
DB_USER=postgres
DB_PASS=
DB_HOST=127.0.0.1

ALLOWED_HOSTS=localhost,127.0.0.1

# Strava API application (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Public URLs for OAuth redirect and frontend
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Random string; must match Strava webhook subscription verify token
STRAVA_WEBHOOK_VERIFY_TOKEN=

SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
